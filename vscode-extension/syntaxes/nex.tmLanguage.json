{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEX",
  "scopeName": "source.nex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#objects" },
    { "include": "#lists" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nex",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.nex",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.nex",
          "match": "\\b(null|true|false)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nex",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nex",
          "match": "\\\\(u[0-9a-fA-F]{4}|[\"\\\\/bfnrt])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nex",
          "match": "-?\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)\\b|-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nex",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "objects": {
      "patterns": [
        {
          "name": "meta.object.named.nex",
          "begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.type.nex" },
            "2": { "name": "punctuation.section.object.begin.nex" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.object.end.nex" }
          },
          "patterns": [{ "include": "#object-content" }]
        },
        {
          "name": "meta.object.anonymous.nex",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.object.begin.nex" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.object.end.nex" }
          },
          "patterns": [{ "include": "#object-content" }]
        }
      ]
    },
    "object-content": {
      "patterns": [
        { "include": "#comments" },
        {
          "name": "meta.key-value.nex",
          "match": "(?:\\b([a-zA-Z_][a-zA-Z0-9_]*)|(\"[^\"]*\"))(?=\\s|\\(|\\[)",
          "captures": {
            "1": { "name": "variable.other.property.nex" },
            "2": { "name": "variable.other.property.nex" }
          }
        },
        { "include": "$self" }
      ]
    },
    "lists": {
      "name": "meta.sequence.nex",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.sequence.begin.nex" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.sequence.end.nex" }
      },
      "patterns": [{ "include": "$self" }]
    },
    "symbols": {
      "name": "variable.other.nex",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
