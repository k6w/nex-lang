{
  "name": "nex-lang",
  "displayName": "nex language support",
  "description": "language support for nex data serialization language",
  "version": "0.1.0",
  "repository": "https://github.com/k6w/nex-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "nex",
      "aliases": ["NEX", "nex"],
      "extensions": [".nex"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nex",
      "scopeName": "source.nex",
      "path": "./syntaxes/nex.tmLanguage.json"
    }],
    "commands": [{
      "command": "nex.restartLsp",
      "title": "Restart NEX Language Server"
    }]
  },
  "activationEvents": [
    "onLanguage:nex"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1"
  }
}